# ========================================================
# REVIEWsite Deployment Environment Variables
# ========================================================

# Server listening port (default: 3001)
PORT=3001

# Application environment ('production' or 'development')
NODE_ENV=production

# Strong random secret key for signed session cookies (32+ chars recommended)
# IMPORTANT: Generate a new random secret before deploying!
# Windows PowerShell: [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
COOKIE_SECRET=replace-with-a-random-32-char-secret-key-in-production

# --------------------------------------------------------
# OPTION A: TURSO CLOUD DATABASE (Recommended for Render)
# 100% Free, No Credit Card, 9GB storage, Never loses data
# --------------------------------------------------------
# TURSO_DATABASE_URL=libsql://reviewsite-yourname.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# --------------------------------------------------------
# OPTION B: LOCAL SQLITE FILE (Default fallback)
# Used automatically if Turso is not configured
# --------------------------------------------------------
DB_PATH=./data/reviewsite.db
